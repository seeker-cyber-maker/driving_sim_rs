+The `nvidia` release archives include a library built with CUDA 13.4 for `sm_75,sm_86,sm_89,sm_120` plus `sm_120` PTX: RTX 20 to RTX 50 GPUs, and later GPUs through the PTX. Other targets, such as `sm_80` (A100) and `sm_90` (H100), need their own build. It links the CUDA runtime statically, so it needs only an NVIDIA driver that supports CUDA 13 (580 or newer).
+
 `OUT` overrides the output directory. `CUDA_ARCH` defaults to `native`, which builds for the GPUs of the build machine. Without a GPU, nvcc 13.4 warns and builds `sm_75` code and PTX instead, which newer GPUs compile at load time. To build for other GPUs, or several, list `sm_` targets separated by commas or spaces; `nvidia-smi --query-gpu=compute_cap --format=csv` reports the number, so 8.6 is `sm_86`. A list also embeds PTX for its newest target, which the driver compiles at load time for a newer GPU. CUDA 13 builds for Turing (`sm_75`, RTX 20 series) and newer only; older GPUs need a CUDA 12 toolkit, which is untested. Both scripts check the double tables with `gpu/gen_tables.py --check` (`python3` on Linux, the `py` launcher or `python` on Windows). The binary loads `ALTD_GPU_LIB`, then the library beside the executable, then `target/gpu`, as on AMD. `altd-sim gpu-info` runs one kernel when a GPU is present, so a library built for another GPU fails there with HIP error 209.
 
 nvcc rejects a Visual Studio newer than the toolkit supports. `gpu/build-cuda.ps1 -AllowUnsupportedCompiler` (or `CUDA_ALLOW_UNSUPPORTED_COMPILER=1`) builds anyway with a warning; NVIDIA has not validated that combination, so run the checks below before trusting the library.
diff --git a/gpu/build.ps1 b/gpu/build.ps1
new file mode 100644
index 0000000..499450f
--- /dev/null
+++ b/gpu/build.ps1
@@ -0,0 +1,28 @@
+# Build altd_gpu.dll (the GPU simulator parts) for AMD GPUs with the HIP SDK for Windows into $OUT.
+# GPU_ARCH lists one or more offload targets separated by commas or spaces.
+# -ffp-contract=off: hipcc otherwise fuses a*b+c into FMA, which rounds once.
+# HIP_PATH is the HIP SDK root, which its installer sets.
+param(
+    [string]$Out = $(if ($env:OUT) { $env:OUT } else { Join-Path $PSScriptRoot "..\target\gpu" }),
+    [string]$Arch = $(if ($env:GPU_ARCH) { $env:GPU_ARCH } else { "gfx1100" })
+)
+$ErrorActionPreference = "Stop"
+New-Item -ItemType Directory -Force $Out | Out-Null
+$Out = (Resolve-Path $Out).Path
+
+# The py launcher first: python3 on Windows is often the Microsoft Store placeholder.
+$tables = Join-Path $PSScriptRoot "gen_tables.py"
+if (Get-Command py -ErrorAction SilentlyContinue) { py -3 $tables --check } else { python $tables --check }
+if ($LASTEXITCODE -ne 0) { throw "gen_tables.py --check failed" }
+
+$targets = @($Arch -split '[,\s]+' | Where-Object { $_ })
+if (-not $targets) { throw "GPU_ARCH lists no targets" }
+if (-not $env:HIP_PATH) { throw "HIP_PATH is not set; install the HIP SDK for Windows" }
+$hipcc = Join-Path $env:HIP_PATH "bin\hipcc.exe"
+
+$src = Join-Path $PSScriptRoot "sim\altd_gpu.hip"
+$dll = Join-Path $Out "altd_gpu.dll"
+& $hipcc -O3 -ffp-contract=off @($targets | ForEach-Object { "--offload-arch=$_" }) -shared -std=c++20 `
+    -fhip-fp32-correctly-rounded-divide-sqrt -o $dll $src -L (Join-Path $env:HIP_PATH "lib") -lamdhip64
+if ($LASTEXITCODE -ne 0) { throw "hipcc failed" }
+Write-Host "built $dll for $($targets -join ' ')"
diff --git a/gpu/sim/altd_gpu.hip b/gpu/sim/altd_gpu.hip
index b0962e3..fafb3ee 100644
--- a/gpu/sim/altd_gpu.hip
+++ b/gpu/sim/altd_gpu.hip
@@ -502,7 +502,8 @@ double thread_cpu_seconds() {
 // runtime's single-dispatch limit, so by default every launch allocates and
 // frees it (0.2-1.7 ms per launch). Keeping the scratch avoids that. Runs at
 // load, before the first HIP call initialises HSA; an explicit setting wins.
-#if !defined(__CUDACC__)
+// HIP on Windows runs on PAL instead of HSA, and its C runtime has no setenv.
+#if !defined(__CUDACC__) && !defined(_WIN32)
 __attribute__((constructor)) void keep_scratch() { setenv("HSA_NO_SCRATCH_RECLAIM", "1", 0); }
 #endif
 
