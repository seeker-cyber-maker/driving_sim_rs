+/// Observe every game reward channel without altering selection or drawing RNG.
+/// The unsigned ranks use the native selection normalization, but missing
+/// measurements remain null instead of exposing selection's zero fallback.
+pub fn reward_descriptors(agents: &[AgentResult]) -> Vec<Value> {
+    let mut channels = Vec::new();
+    for metric in METRIC_NAMES {
+        for kind in ["default", "average"] {
+            if (kind == "default" && AVERAGE_ONLY_METRICS.contains(&metric))
+                || (kind == "average" && !AVERAGE_METRICS.contains(&metric))
+            {
+                continue;
+            }
+            let spec = RewardSpec {
+                metric: metric.into(),
+                weight: 100,
+                kind: kind.into(),
+            };
+            let values: Vec<Option<f64>> = agents
+                .iter()
+                .map(|agent| {
+                    if kind == "average" && agent.update_count == 0 {
+                        None
+                    } else {
