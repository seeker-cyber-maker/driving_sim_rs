+//! Read-only generation-boundary observations and immutable winner snapshots.
+use altd_sim::training::{
+    evolution::{reward_descriptors, METRIC_NAMES},
+    TrainingRunner,
+};
+use serde_json::{json, Value};
+use std::{
+    fs::File,
+    io::{BufWriter, Write},
+    path::{Path, PathBuf},
+};
+
+const MAX_DESCRIPTOR_BYTES: usize = 256 * 1024 * 1024;
+
+pub(super) struct Analysis {
+    dir: PathBuf,
+    output: BufWriter<File>,
+    bytes: usize,
+    rows: usize,
+    clean_min_laps: u64,
+    frozen: bool,
+    fitness: Option<Value>,
+    fastest: Option<Value>,
+    clean: Option<Value>,
+    evaluation: Option<Value>,
+}
+
+fn weight_hash(params: &[f64]) -> String {
+    let bytes: Vec<u8> = params.iter().flat_map(|p| p.to_le_bytes()).collect();
+    altd_sim::training::evaluation::sha256(&bytes)
+}
+
+fn eligible(row: &Value, clean_min_laps: Option<u64>) -> bool {
+    row["objectives"]["best_lap_seconds"]
+        .as_f64()
+        .is_some_and(|v| v.is_finite() && v > 0.0)
+        && row["objectives"]["forward_laps"]
+            .as_u64()
+            .is_some_and(|laps| laps >= clean_min_laps.unwrap_or(1))
+        && (clean_min_laps.is_none() || row["objectives"]["physical_contacts"].as_u64() == Some(0))
+}
+
+fn better_lap(row: &Value, previous: Option<&Value>) -> bool {
+    previous.is_none_or(|old| {
+        row["objectives"]["best_lap_seconds"].as_f64().unwrap()
+            < old["objectives"]["best_lap_seconds"].as_f64().unwrap()
+    })
+}
+
+impl Analysis {
+    pub(super) fn new(dir: &Path, clean_min_laps: u64, frozen: bool) -> Self {
+        assert!((1..=100).contains(&clean_min_laps), "clean minimum laps must be 1..100");
+        let dir = dir.join("analysis");
+        std::fs::create_dir_all(dir.join("winners")).expect("analysis directory");
+        let output = BufWriter::new(File::create(dir.join("descriptors.jsonl")).expect("analysis descriptors"));
+        Self {
+            dir,
+            output,
+            bytes: 0,
+            rows: 0,
+            clean_min_laps,
+            frozen,
+            fitness: None,
+            fastest: None,
+            clean: None,
+            evaluation: None,
+        }
+    }
+
+    fn snapshot(&self, role: &str, row: &Value, runner: &TrainingRunner, index: usize, network_data: &Value) {
+        let mut network = runner.agents[index].network.to_json();
+        network["inputs"] = network_data["inputs"].clone();
+        network["outputs"] = network_data["outputs"].clone();
+        network["observation"] = row.clone();
+        std::fs::write(
+            self.dir.join(format!("winners/{role}.json")),
+            serde_json::to_vec(&network).unwrap(),
+        )
+        .expect("immutable selected weight snapshot");
+    }
+
+    pub(super) fn record(&mut self, runner: &TrainingRunner, generation: usize, fitness: &[f64], network_data: &Value) {
+        assert_eq!(fitness.len(), runner.agents.len());
+        let channels = reward_descriptors(&runner.results());
+        assert_eq!(channels.len(), 18);
+        let leader = if self.frozen {
+            0
+        } else {
+            super::runner::final_candidate_leader(fitness)
+        };
+        for (index, agent) in runner.agents.iter().enumerate() {
+            let raw: serde_json::Map<String, Value> = METRIC_NAMES
+                .iter()
+                .zip(agent.stats.metrics())
+                .map(|(name, value)| ((*name).into(), json!(value.filter(|v| v.is_finite()))))
+                .collect();
+            let channel_values: Vec<Value> = channels.iter().map(|c| c["values"][index].clone()).collect();
+            let channel_ranks: Vec<Value> = channels
+                .iter()
+                .map(|c| c["population_relative"][index].clone())
+                .collect();
+            let reasons: Vec<Value> = channels
+                .iter()
+                .map(|column| {
+                    if !column["values"][index].is_null() {
+                        Value::Null
+                    } else if column["metric"] == "best_lap_performance" {
+                        json!("no_completed_lap")
+                    } else if column["type"] == "average" && agent.stats.update_count == 0 {
+                        json!("no_statistics_updates")
+                    } else {
+                        json!("not_observed")
+                    }
+                })
+                .collect();
+            let row = json!({"schema":1, "generation":generation + 1, "car":index,
+                "candidate_id":format!("g{:06}-c{:06}", generation + 1, index),
+                "ticks_elapsed":runner.tick, "stats_update_count":agent.stats.update_count,
+                "raw_metrics":raw, "channels":{"values":channel_values, "population_relative":channel_ranks, "unavailable_reasons":reasons},
+                "selection_fitness":if self.frozen {Value::Null} else {json!(fitness[index])},
+                "objectives":{"best_lap_seconds":agent.stats.best_lap_time.filter(|v| v.is_finite() && *v > 0.0),
+                    "forward_laps":agent.stats.score.lap_count, "physical_contacts":agent.car.collision_count,
+                    "collision_updates":agent.stats.collision_count, "total_actual_distance":agent.stats.total_actual_distance,
+                    "active":agent.car.active},
+                "weights_sha256":weight_hash(&agent.network.params)});
+            let text = serde_json::to_vec(&row).expect("finite descriptor");
+            self.bytes += text.len() + 1;
+            assert!(
+                self.bytes <= MAX_DESCRIPTOR_BYTES,
+                "complete analysis exceeds 256 MiB; no descriptors truncated"
+            );
+            self.output
+                .write_all(&text)
+                .and_then(|_| self.output.write_all(b"\n"))
+                .expect("descriptor write");
+            self.rows += 1;
+            if self.frozen {
+                self.evaluation = Some(row);
+                continue;
+            }
+            // Replacing only on a strictly better lap retains the earliest generation/car tie.
+            if eligible(&row, None) && better_lap(&row, self.fastest.as_ref()) {
+                self.snapshot("fastest_lap", &row, runner, index, network_data);
+                self.fastest = Some(row.clone());
+            }
+            if eligible(&row, Some(self.clean_min_laps)) && better_lap(&row, self.clean.as_ref()) {
+                self.snapshot("clean_laps", &row, runner, index, network_data);
+                self.clean = Some(row.clone());
+            }
+            // Fitness ranks belong to this population. Always overwrite with this generation's leader.
+            if index == leader {
+                self.snapshot("fitness", &row, runner, index, network_data);
+                self.fitness = Some(row);
+            }
+        }
+        self.output.flush().expect("flush complete descriptors before turnover");
+    }
+
+    pub(super) fn finish(mut self) {
+        self.output.flush().expect("flush analysis");
+        let data = json!({"schema":"ald.native-analysis", "version":1, "rows":self.rows,
+            "mode":if self.frozen {"evaluate"} else {"train"}, "clean_min_laps":self.clean_min_laps,
+            "winners":{"fitness":self.fitness, "fastest_lap":self.fastest, "clean_laps":self.clean},
+            "evaluation":self.evaluation, "metric_names":METRIC_NAMES});
+        std::fs::write(self.dir.join("analysis.json"), serde_json::to_vec(&data).unwrap()).expect("analysis summary");
+    }
+}
+
+#[cfg(test)]
+#[path = "../../../../examples/support/generated.rs"]
+mod generated;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn row(laps: u64, contacts: u64, lap: Option<f64>) -> Value {
+        json!({"objectives":{"forward_laps":laps,"physical_contacts":contacts,"best_lap_seconds":lap}})
+    }
+    #[test]
+    fn distinct_roles_keep_global_laps_but_final_population_fitness_and_old_weights() {
+        use altd_sim::{
+            math::profile::MathProfile,
+            nn::network::Network,
+            track::world::{vector, World},
+            training::{evolution::EvolutionSettings, pyrandom::PyRandom, SensorLayout},
+        };
+        use std::sync::Arc;
+        let scene = generated::scene("formula", 0);
+        let network_data = json!({"inputs":["Speed"], "outputs":["Acceleration"]});
+        let layout = SensorLayout::from_ordered(&json!({"names":["Speed"], "sensors":[{"$type":"speed"}]})).unwrap();
+        let mut runner = TrainingRunner::new(
+            Arc::new(World::from_scene_with(&scene, MathProfile::Proton)),
+            vector(&scene["reset_position"]),
+            scene["reset_rotation"].as_f64().unwrap(),
+            layout,
+            &["Acceleration".into()],
+            EvolutionSettings::default(),
+            PyRandom::new(42),
+            2,
+            0,
+            false,
+            false,
+        );
+        let networks: Vec<_> = (0..3)
+            .map(|i| Network::from_vector(&[1, 1], vec![i as f64, 0.0]))
+            .collect();
+        runner.resume(&networks, 0);
+        for (i, agent) in runner.agents.iter_mut().enumerate() {
+            agent.stats.update_count = 10;
+            agent.stats.best_lap_time = [None, Some(5.0), Some(8.0)][i];
+            agent.stats.score.lap_count = [0, 1, 2][i];
+            // Reward collision updates cannot disqualify a physically clean car.
+            agent.stats.collision_count = if i == 2 { 9 } else { 0 };
+        }
+        let dir = std::env::temp_dir().join(format!("ald-distinct-winners-{}", std::process::id()));
+        std::fs::create_dir(&dir).unwrap();
+        let mut writer = Analysis::new(&dir, 2, false);
+        writer.record(&runner, 0, &[0.9, 0.7, 0.1], &network_data);
+        assert_eq!(writer.clean.as_ref().unwrap()["car"], 2);
+        for (i, agent) in runner.agents.iter_mut().enumerate() {
+            agent.network.params = vec![10.0 + i as f64, 0.0];
+            agent.stats.best_lap_time = [Some(6.0), Some(5.0), None][i];
+            agent.stats.score.lap_count = [2, 2, 0][i];
+            agent.car.collision_count = if i == 0 { 1 } else { 0 };
+        }
+        writer.record(&runner, 1, &[0.0, 0.5, 0.2], &network_data);
+        assert_eq!(writer.fastest.as_ref().unwrap()["generation"], 1);
+        assert_eq!(writer.fastest.as_ref().unwrap()["car"], 1);
+        assert_eq!(writer.clean.as_ref().unwrap()["generation"], 2);
+        assert_eq!(writer.fitness.as_ref().unwrap()["generation"], 2);
+        assert_eq!(writer.fitness.as_ref().unwrap()["selection_fitness"], 0.5);
+        let fastest: Value =
+            serde_json::from_slice(&std::fs::read(dir.join("analysis/winners/fastest_lap.json")).unwrap()).unwrap();
+        assert_eq!(fastest["weights"][0][0][0], 1.0);
+        writer.finish();
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn clean_requires_forward_laps_and_physical_contacts_not_reward_updates() {
+        assert!(!eligible(&row(0, 0, None), None));
+        assert!(eligible(&row(1, 3, Some(10.0)), None));
+        assert!(!eligible(&row(1, 0, Some(10.0)), Some(2)));
+        assert!(!eligible(&row(2, 1, Some(10.0)), Some(2)));
+        assert!(eligible(&row(2, 0, Some(10.0)), Some(2)));
+    }
+    #[test]
+    fn lap_ties_keep_earlier_snapshot_and_rank_fitness_is_not_a_tiebreaker() {
+        let old = row(2, 0, Some(10.0));
+        assert!(!better_lap(&old, Some(&old)));
+        assert!(better_lap(&row(2, 0, Some(9.0)), Some(&old)));
+    }
+}
