+//! Fresh-policy statistics callback telemetry only; no challenge predicates.
+use altd_sim::training::TrainingRunner;
+use serde_json::json;
+use std::{fs::File, io::{BufWriter, Write}, path::{Path, PathBuf}};
+
+pub(super) struct ChallengeObservations {
+    output: BufWriter<File>,
+    dir: PathBuf,
+    requested_ticks: u64,
+    lap_score: f64,
+    backend: &'static str,
+    frames: u64,
+}
+
+impl ChallengeObservations {
+    pub(super) fn new(dir: &Path, requested_ticks: u64, lap_score: f64, backend: &'static str) -> Self {
+        assert!(lap_score.is_finite() && lap_score > 0.0, "challenge observations require a positive native lap score");
+        Self { output: BufWriter::new(File::create(dir.join("challenge-observations.jsonl")).expect("create callback observations")),
+            dir: dir.to_owned(), requested_ticks, lap_score, backend, frames: 0 }
+    }
+
+    pub(super) fn sample(&mut self, runner: &TrainingRunner, callback_active: bool) {
+        assert_eq!(runner.agents.len(), 1);
+        assert_eq!(runner.tick % 6, 0);
+        let agent = &runner.agents[0];
+        let stats = &agent.stats;
+        // An active callback updates previous_speed before driving. An inactive
+        // terminal callback stops before driving and its car speed is exact.
+        let velocity = altd_sim::math::godot_math::F2::from(agent.car.velocity);
+        let speed = if callback_active { stats.previous_speed }
+            else { velocity.dot(velocity).sqrt() as f64 };
+        let row = json!({"tick":runner.tick, "game_time":((runner.tick - 6) / 6) as f64 * 0.1,
+            "stats_update_count":stats.update_count, "current_score":stats.score.total_score,
+            "current_best_score":stats.score.total_score, "worst_score":stats.score.total_score,
+            "went_backwards":stats.score.went_backwards, "forward_laps":stats.score.lap_count,
+            "drift_cumulative":stats.total_drifting_amount,
+            "continuous_drift_time":stats.continuous_drift_time,
+            "max_continuous_drift_time":stats.max_continuous_drift_time,
+            "speed_kph":speed / 15.0 * 3.6, "collision_count":stats.collision_count,
+            "active":callback_active, "best_lap_seconds":stats.best_lap_time});
+        serde_json::to_writer(&mut self.output, &row).expect("write callback observation");
+        self.output.write_all(b"\n").expect("write callback newline");
+        self.frames += 1;
+    }
+
+    pub(super) fn finish(mut self) {
+        self.output.flush().expect("flush all callback observations");
+        let meta = json!({"schema":"ald.challenge-observations", "version":1, "mode":"evaluate",
+            "lap_score":self.lap_score, "stats_interval_seconds":0.1, "first_stats_tick":6,
+            "requested_ticks":self.requested_ticks, "frames":self.frames, "execution_backend":self.backend,
+            "active_semantics":"after_statistics_before_drive",
+            "collision_semantics":"AgentStats collision update count, not physical contact count",
+            "score_semantics":"Signed path score; single-car current_best_score and worst_score equal current_score"});
+        std::fs::write(self.dir.join("challenge-observations-meta.json"), serde_json::to_vec(&meta).unwrap())
+            .expect("write callback metadata");
+    }
+}
