+#[test]
+fn challenge_callbacks_preserve_frozen_schedule_and_capture_every_statistics_update() {
+    let root = workspace("challenge-callbacks");
+    run(&root, "plain", &["--analysis", "--evaluate-frozen"]);
+    run(&root, "observed", &["--analysis", "--evaluate-frozen", "--challenge-observations"]);
+    let plain = fs::read(root.join("plain/analysis/descriptors.jsonl")).unwrap();
+    let observed = fs::read(root.join("observed/analysis/descriptors.jsonl")).unwrap();
+    assert_eq!(plain, observed, "callback readback must not alter any final physical/statistical measurement or weights");
+    let rows: Vec<Value> = fs::read_to_string(root.join("observed/challenge-observations.jsonl"))
+        .unwrap().lines().map(|line| serde_json::from_str(line).unwrap()).collect();
+    assert_eq!(rows.len(), 11, "60 requested ticks use callbacks 6 through 66 inclusive");
+    let final_row: Value = serde_json::from_slice(&observed).unwrap();
+    for (index, row) in rows.iter().enumerate() {
+        assert_eq!(row["tick"], (index + 1) * 6);
+        assert_eq!(row["game_time"].as_f64().unwrap(), index as f64 * 0.1);
+        assert_eq!(row["stats_update_count"], index + 1);
+        assert_eq!(row["current_score"], row["worst_score"]);
+        assert_eq!(row["current_score"], row["current_best_score"]);
+        assert_eq!(row["active"], true);
+        assert!(row["speed_kph"].as_f64().unwrap().is_finite());
+    }
+    let speed_sum: f64 = rows.iter().map(|row| row["speed_kph"].as_f64().unwrap() / 3.6 * 15.0).sum();
+    assert!((speed_sum - final_row["raw_metrics"]["total_speed"].as_f64().unwrap()).abs() < 1e-8,
+        "every speed sample must describe the statistics callback, not its following drive step");
+    assert_eq!(rows.last().unwrap()["current_score"], final_row["raw_metrics"]["total_score"]);
+    assert_eq!(rows.last().unwrap()["collision_count"], final_row["objectives"]["collision_updates"]);
+    let meta = load(root.join("observed/challenge-observations-meta.json"));
+    assert_eq!(meta["frames"], rows.len());
+    assert!(meta["lap_score"].as_f64().unwrap() > 0.0);
+    fs::remove_dir_all(root).unwrap();
+}
+#[test]
+fn observation_is_rng_neutral_and_final_winner_matches_exact_pre_turnover_parameters() {
+    let root = workspace("neutral");
+    run(&root, "plain", &[]);
+    run(&root, "observed", &["--analysis"]);
+    assert_eq!(
+        load(root.join("plain/candidate.json")),
+        load(root.join("observed/candidate.json"))
+    );
+    let plain: Vec<Value> = fs::read_to_string(root.join("plain/log.jsonl"))
+        .unwrap()
+        .lines()
+        .map(|l| serde_json::from_str(l).unwrap())
+        .collect();
+    let observed: Vec<Value> = fs::read_to_string(root.join("observed/log.jsonl"))
+        .unwrap()
+        .lines()
+        .map(|l| serde_json::from_str(l).unwrap())
+        .collect();
+    for (a, b) in plain.iter().zip(&observed) {
+        for key in [
+            "best_score",
+            "mean_score",
+            "best_fitness",
+            "mean_fitness",
+            "total_metric_values",
+            "simulated_ticks",
+        ] {
+            assert_eq!(a[key], b[key], "{key}");
+        }
+    }
+    let summary = load(root.join("observed/analysis/analysis.json"));
+    assert_eq!(summary["rows"], 8);
+    assert_eq!(summary["winners"]["fitness"]["generation"], 2);
+    let selected = load(root.join("observed/analysis/winners/fitness.json"));
+    let candidate = load(root.join("observed/candidate.json"));
+    assert_eq!(selected["weights"], candidate["weights"]);
+    assert_eq!(selected["biases"], candidate["biases"]);
+    assert!(summary["winners"]["fastest_lap"].is_null());
+    assert!(summary["winners"]["clean_laps"].is_null());
+    let rows: Vec<Value> = fs::read_to_string(root.join("observed/analysis/descriptors.jsonl"))
+        .unwrap()
+        .lines()
+        .map(|l| serde_json::from_str(l).unwrap())
+        .collect();
+    assert_eq!(rows.len(), 8);
+    assert_eq!(rows[0]["raw_metrics"].as_object().unwrap().len(), 14);
+    assert_eq!(rows[0]["channels"]["values"].as_array().unwrap().len(), 18);
+    assert!(rows.iter().any(|row| row == &selected["observation"]));
+    fs::remove_dir_all(root).unwrap();
+}
+#[test]
+fn frozen_evaluation_never_breeds_or_decays_and_has_no_parent_candidate() {
+    let root = workspace("frozen");
+    run(&root, "evaluated", &["--analysis", "--evaluate-frozen"]);
+    let summary = load(root.join("evaluated/analysis/analysis.json"));
+    assert_eq!(summary["rows"], 1);
+    assert!(summary["winners"]["fitness"].is_null());
+    assert!(summary["evaluation"]["selection_fitness"].is_null());
+    let seed = Network::from_game_export(&load(root.join("seed.json")));
+    let bytes: Vec<u8> = seed.params.iter().flat_map(|p| p.to_le_bytes()).collect();
+    assert_eq!(
+        summary["evaluation"]["weights_sha256"],
+        altd_sim::training::evaluation::sha256(&bytes)
+    );
+    assert!(!root.join("evaluated/candidate.json").exists());
+    assert!(!root.join("evaluated/checkpoint.json").exists());
+    fs::remove_dir_all(root).unwrap();
