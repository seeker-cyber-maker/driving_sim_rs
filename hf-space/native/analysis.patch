+#[test]
+fn challenge_callbacks_preserve_idle_and_inactive_cutoffs() {
+    let seed = Network::from_vector(&[20, 5], vec![0.0; 105]);
+    for inactive in [false, true] {
+        let mut plain = generated_runner(1);
+        let mut observed = generated_runner(1);
+        plain.resume(&[seed.clone()], 0);
+        observed.resume(&[seed.clone()], 0);
+        if inactive {
+            plain.agents[0].car.deactivate();
+            observed.agents[0].car.deactivate();
+        } else {
+            plain.agents[0].stats.idle_ticks = 79;
+            observed.agents[0].stats.idle_ticks = 79;
+        }
+        let expected = plain.advance_generation(600);
+        let mut frames = Vec::new();
+        let actual = observed.advance_generation_observed(600, |runner, active| {
+            frames.push((runner.tick, active, runner.agents[0].stats.update_count));
+        });
+        assert_eq!(expected, actual, "callback mode must stop at the same pre-drive frame");
+        assert_same_agents(&plain, &observed);
+        if inactive {
+            assert_eq!(frames, vec![(6, false, 0)]);
+        } else {
+            assert_eq!(frames, vec![(6, true, 1), (12, false, 2)]);
+        }
+    }
