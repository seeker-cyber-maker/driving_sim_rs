+//! Native boundary checks: observations preserve evolution and frozen policies.
+use altd_sim::nn::network::Network;
+use serde_json::{json, Value};
+use std::{fs, path::Path, process::Command};
+#[path = "../examples/support/generated.rs"]
+mod generated;
+fn load(path: impl AsRef<Path>) -> Value {
+    serde_json::from_slice(&fs::read(path).unwrap()).unwrap()
+}
+fn run(root: &Path, name: &str, extra: &[&str]) {
+    let mut command = Command::new(env!("CARGO_BIN_EXE_altd-sim"));
+    command
+        .args([
+            "--threads",
+            "1",
+            "--math-profile",
+            "proton",
+            "train-scratch",
+            "--shape",
+            "20,5",
+            "--population",
+            if extra.contains(&"--evaluate-frozen") { "1" } else { "4" },
+            "--generations",
+            if extra.contains(&"--evaluate-frozen") { "1" } else { "2" },
+            "--ticks",
+            "60",
+            "--mutation-start",
+            "0.2",
+            "--mutation-end",
+            "0.2",
+            "--seed",
+            "42",
+            "--checkpoint-every",
+            "0",
+            "--save-final-candidate",
+            "--no-idle-eliminate",
+            "--no-eliminate-on-wall",
+        ])
+        .arg("--scene")
+        .arg(root.join("scene.json"))
+        .arg("--spawn-trace")
+        .arg(root.join("spawn.json"))
+        .arg("--network")
+        .arg(root.join("seed.json"))
+        .arg("--init-network")
+        .arg(root.join("seed.json"))
+        .arg("--model")
+        .arg(concat!(env!("CARGO_MANIFEST_DIR"), "/assets/models/rally.json"))
+        .arg("--settings")
+        .arg(root.join("settings.json"))
+        .arg("--out-dir")
+        .arg(root.join(name))
+        .args(extra);
+    let output = command.output().unwrap();
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+}
+fn workspace(tag: &str) -> std::path::PathBuf {
+    let root = std::env::temp_dir().join(format!("ald-winner-analysis-{}-{tag}", std::process::id()));
+    fs::create_dir(&root).unwrap();
+    let scene = generated::scene("rally", 0);
+    let metadata = generated::network("rally");
+    let mut seed = Network::from_vector(&[20, 5], vec![0.1; 105]).to_json();
+    seed["inputs"] = metadata["inputs"].clone();
+    seed["outputs"] = metadata["outputs"].clone();
+    for (name, value) in [
+        ("scene.json", scene.clone()),
+        ("seed.json", seed),
+        ("spawn.json", json!({"frames":[generated::spawn(&scene)]})),
+        (
+            "settings.json",
+            json!({"selection_algorithm":"best","selection_size":1,"preserve_parents":"on_custom",
+            "preserve_parents_size":1,"weight_decay":0.8,"rewards":[{"metric":"total_actual_distance","weight":100,"type":"default"}]}),
+        ),
+    ] {
+        fs::write(root.join(name), value.to_string()).unwrap();
+    }
+    root
+}
